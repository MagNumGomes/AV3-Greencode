DATABASE_URL="postgresql://greencode:greencode_dev@localhost:5432/greencode?schema=public"
HOST=127.0.0.1
PORT=3333
# Substitua por uma sequência aleatória com pelo menos 32 caracteres.
JWT_SECRET="troque-esta-chave-local-por-uma-chave-aleatoria"
JWT_EXPIRES_IN=30m
CORS_ORIGINS=http://localhost:5173
# Senha comum às quatro contas de demonstração; obrigatória para executar o seed.
SEED_PASSWORD="Greencode-demo-2026!"

# ---------- AV3: fila BullMQ/Redis, agendador analítico e limites ----------
# Com REDIS_URL definida, a fila e o agendador usam BullMQ + Redis.
# Sem REDIS_URL, o servidor opera com fila em memória e node-cron para desenvolvimento local.
REDIS_URL="redis://127.0.0.1:6379"
WORKER_EMBUTIDO=true
WORKER_CONCORRENCIA=2
FILA_TENTATIVAS=4
FILA_BACKOFF_MS=5000
ANALISES_CRON="0 3 * * *"
ANALISES_FUSO="America/Sao_Paulo"
LOGIN_POR_MINUTO=10
